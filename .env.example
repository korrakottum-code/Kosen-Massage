# ตั้งค่าใน Vercel → Project → Settings → Environment Variables

# LINE Login channel (ที่สร้าง LIFF app)
LIFF_ID=2000000000-xxxxxxxx
LINE_LOGIN_CHANNEL_ID=2000000000

# LINE Messaging API channel (LINE OA ของร้าน) — ใช้ส่งแจ้งเตือน
LINE_CHANNEL_ACCESS_TOKEN=
# userId หรือ groupId ที่จะรับแจ้งเตือนฝั่งร้าน (หลายค่าคั่นด้วย ,)
LINE_ADMIN_TO=
LINE_OA_URL=https://lin.ee/xxxxxxx

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL ของเว็บบน Vercel (ใส่ลิงก์หน้า admin ในข้อความแจ้งเตือน)
PUBLIC_BASE_URL=https://kosen-massage.vercel.app
